{
  "schema_version": "1.0",
  "name": "recipe-enlargement",
  "title": "Proportional Enlargement",
  "description": "Upscale proportionally with detail preservation and restrained output sharpening.",
  "version": "0.1.0",
  "author": "wspotter",
  "license": "MIT",
  "app": "photocraft",
  "media_type": "photo",
  "default_output_suffix": ".png",
  "parameters": {
    "scale": {"type": "number", "default": 2.0},
    "resample": {"type": "string", "default": "preserveDetails"},
    "sharpen_amount": {"type": "integer", "default": 40},
    "sharpen_radius": {"type": "number", "default": 0.8}
  },
  "steps": [
    {
      "id": "inspect",
      "tool": "artcraft_prepare_inspection",
      "args": {
        "path": "{input}",
        "working_dir": "{work_dir}/inspect"
      }
    },
    {
      "id": "restore",
      "tool": "artcraft_restore_step",
      "args": {
        "input_path": "{input}",
        "output_path": "{output}",
        "recipe": "enlargement",
        "parameters": {
          "scale": "{params.scale}",
          "resample": "{params.resample}",
          "sharpen_amount": "{params.sharpen_amount}",
          "sharpen_radius": "{params.sharpen_radius}"
        },
        "checkpoint_dir": "{work_dir}/checkpoints",
        "step_name": "06_enlargement"
      }
    },
    {
      "id": "review",
      "tool": "artcraft_build_review",
      "args": {
        "source_path": "{input}",
        "output_path": "{output}",
        "working_dir": "{work_dir}/review"
      }
    }
  ]
}
