{
  "schema_version": "1.0",
  "name": "recipe-color-cast",
  "title": "Color Cast Balance",
  "description": "Neutralize vintage color casts while preserving skin warmth and highlights.",
  "version": "0.1.0",
  "author": "wspotter",
  "license": "MIT",
  "app": "photocraft",
  "media_type": "photo",
  "default_output_suffix": ".png",
  "parameters": {
    "midtones": {"type": "array", "default": [0, 0, 15]},
    "shadows": {"type": "array", "default": [0, 0, 0]},
    "highlights": {"type": "array", "default": [0, 0, 0]},
    "preserve_luminosity": {"type": "boolean", "default": true}
  },
  "steps": [
    {
      "id": "inspect",
      "tool": "artcraft_prepare_inspection",
      "args": {
        "path": "{input}",
        "working_dir": "{work_dir}/inspect"
      }
    },
    {
      "id": "restore",
      "tool": "artcraft_restore_step",
      "args": {
        "input_path": "{input}",
        "output_path": "{output}",
        "recipe": "color_cast",
        "parameters": {
          "midtones": "{params.midtones}",
          "shadows": "{params.shadows}",
          "highlights": "{params.highlights}",
          "preserveLuminosity": "{params.preserve_luminosity}"
        },
        "checkpoint_dir": "{work_dir}/checkpoints",
        "step_name": "02_color_cast"
      }
    },
    {
      "id": "review",
      "tool": "artcraft_build_review",
      "args": {
        "source_path": "{input}",
        "output_path": "{output}",
        "working_dir": "{work_dir}/review"
      }
    }
  ]
}
